DATABASE_URL=file:../db/custom.db

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: seeds a default admin account on first boot if both are set.
# Leave unset to skip admin seeding entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Selects the backend for chat-based AI features (quiz generation,
# evaluation, tutoring). "zai" (default) uses z-ai-web-dev-sdk; "anthropic"
# uses the Anthropic API and requires ANTHROPIC_API_KEY. Speech-to-text and
# text-to-speech (src/lib/audio.ts) still depend on z-ai-web-dev-sdk either way.
AI_PROVIDER=zai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
